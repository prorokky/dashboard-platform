{
  "name": "cases",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build-only -- --mode development",
    "dev": "vite preview",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "build:watch": "vite build --watch --mode development",
    "type-check": "vue-tsc --build tsconfig.app.json",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint src --fix --ignore-pattern \"src/**/__tests__/**\" --no-error-on-unmatched-pattern",
    "lint:eslint": "eslint \"src/**/*.{vue,ts,tsx}\" --fix --cache",
    "format": "prettier --write --experimental-cli \"src/**/*.{vue,ts,tsx}\" \"!src/**/__tests__/**\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "pinia": "^3.0.4",
    "platform-ui": "file:../platform-ui",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@playwright/test": "^1.59.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "chokidar": "^5.0.0",
    "commitlint": "^21.0.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
